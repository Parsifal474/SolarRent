<Window x:Class="SolarRent.Views.ClientOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История заказов" Height="450" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ClientName, StringFormat='Клиент: {0}'}" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <ListView Grid.Row="1" ItemsSource="{Binding Orders}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Оборудование" DisplayMemberBinding="{Binding Equipment.Name}" Width="200"/>
                    <GridViewColumn Header="Начало" DisplayMemberBinding="{Binding StartDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <GridViewColumn Header="Окончание" DisplayMemberBinding="{Binding EndDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding RentalPrice, StringFormat='{}{0:N0} ₽'}" Width="100"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Grid.Row="2" Content="Закрыть" Width="100" Height="35" Margin="0,15,0,0"
                Background="#E5E7EB" Foreground="#374151" FontSize="14" FontWeight="Medium"
                BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
    </Grid>
</Window>