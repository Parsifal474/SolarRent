<Window x:Class="SolarRent.Views.DayEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="События дня" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>
        <Style x:Key="EventItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="10">
            <ItemsControl x:Name="EventsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EventItemStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding EventType}" FontWeight="Bold" Foreground="#2E2EFF"/>
                                    <TextBlock Text=" | " />
                                    <TextBlock Text="{Binding EquipmentName}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding ClientName, StringFormat='Клиент: {0}'}" 
                                           FontSize="13" Foreground="#555" Margin="0,4"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="Сумма: " FontSize="13"/>
                                    <TextBlock Text="{Binding Amount, StringFormat='{}{0:N0} ₽'}" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text=" | Статус: " Margin="10,0,0,0" FontSize="13"/>
                                    <TextBlock Text="{Binding Status}" FontSize="13" Foreground="#2E2EFF"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть" Width="100" Height="35" Margin="10"
                Background="#E5E7EB" Foreground="#374151" FontSize="14" FontWeight="Medium"
                BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
    </Grid>
</Window>
