<Page x:Class="SolarRent.Views.Pages.RentalCalendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:SolarRent.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Календарь аренды"
      Background="#F5F5F5">

    <Page.Resources>
        <!-- Конвертер BooleanToVisibility -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Кисти для дней -->
        <SolidColorBrush x:Key="FreeDayBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="RentalDayBrush" Color="#A5D6A5"/>
        <SolidColorBrush x:Key="SoldDayBrush" Color="#FFCC80"/>
        <SolidColorBrush x:Key="MixedDayBrush" Color="#90CAF9"/>

        <!-- Стиль кнопки дня -->
        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FreeDayBrush}"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <!-- Цвет по типу первого события, если событие одно -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Events.Count}" Value="1"/>
                        <Condition Binding="{Binding Events[0].EventType}" Value="Аренда"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource RentalDayBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Events.Count}" Value="1"/>
                        <Condition Binding="{Binding Events[0].EventType}" Value="Продажа"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SoldDayBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Events.Count}" Value="2">
                    <Setter Property="Background" Value="{StaticResource MixedDayBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Events.Count}" Value="3">
                    <Setter Property="Background" Value="{StaticResource MixedDayBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#2E2EFF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок месяца и навигация -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="←" FontSize="18" FontWeight="Bold" Width="40" Height="40"
                    Background="#E0E0E0" BorderThickness="0" Cursor="Hand"
                    Command="{Binding PreviousMonthCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentMonth, StringFormat='{}{0:MMMM yyyy}'}" 
                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <Button Grid.Column="2" Content="→" FontSize="18" FontWeight="Bold" Width="40" Height="40"
                    Background="#E0E0E0" BorderThickness="0" Cursor="Hand"
                    Command="{Binding NextMonthCommand}"/>
        </Grid>

        <!-- Дни недели -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Пн" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Вт" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Ср" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Чт" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Пт" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="Сб" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="Вс" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Сетка календаря -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DayButtonStyle}" 
                            Command="{Binding DataContext.DayClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding TooltipText}">
                        <Grid>
                            <TextBlock Text="{Binding DayNumber}" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"/>
                            <ItemsControl ItemsSource="{Binding Events}" Margin="4,30,4,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EquipmentName}" FontSize="10" 
                                                   Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Индикатор загрузки -->
        <ProgressBar Grid.RowSpan="3" IsIndeterminate="True" Height="4" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</Page>