<Page x:Class="SolarRent.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройки"
      Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы (можно оставить пустым, т.к. шапка окна уже содержит название) -->
        <TextBlock Grid.Row="0" Text="Настройки системы" FontSize="24" FontWeight="Bold" 
                   Margin="20,20,20,10" Foreground="#333"/>

        <StackPanel Grid.Row="1" Margin="20,10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Кнопка создания аккаунта (только для директора) -->
            <Button Content="Создать аккаунт сотрудника" 
                    Width="250" Height="50"
                    Background="#7C3AED" Foreground="White"
                    FontSize="16" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"
                    Click="CreateAccountButton_Click"
                    Margin="0,0,0,20"/>

            <!-- Здесь можно добавить другие настройки -->
            <Button Content="Выход из системы" 
                    Width="250" Height="50"
                    Background="#EF5350" Foreground="White"
                    FontSize="16" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"
                    Click="LogoutButton_Click"/>
        </StackPanel>
    </Grid>
</Page>