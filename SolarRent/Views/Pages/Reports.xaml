<Page x:Class="SolarRent.Views.Pages.Reports"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёты"
      Background="#F5F5F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#66BB6A"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#FF9800"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF5350"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="DebtorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ФИЛЬТР ПО ДАТЕ -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Период отчёта" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="С:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" Height="35" Margin="0,0,20,0"/>

                        <TextBlock Grid.Column="2" Text="По:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" Height="35" Margin="0,0,20,0"/>

                        <Button Grid.Column="5" Content="Применить" 
                                Command="{Binding ApplyDateFilterCommand}"
                                Width="120" Height="35"
                                Background="#2E2EFF" Foreground="White"
                                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- КАРТОЧКИ СТАТИСТИКИ -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Выручка -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Выручка" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} ₽'}" 
                                   Style="{StaticResource StatValueStyle}"/>
                        <TextBlock Text="за выбранный период" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Количество заказов -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Заказов" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding TotalOrders, StringFormat='{}{0:N0}'}" 
                                   Style="{StaticResource StatValueStyle}"/>
                        <TextBlock Text="за выбранный период" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Новые клиенты -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Новых клиентов" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding NewClients, StringFormat='{}{0:N0}'}" 
                                   Style="{StaticResource StatValueStyle}"/>
                        <TextBlock Text="за выбранный период" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Средний чек -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Средний чек" FontSize="14" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding AverageCheck, StringFormat='{}{0:N0} ₽'}" 
                                   Style="{StaticResource StatValueStyle}"/>
                        <TextBlock Text="за выбранный период" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ОСНОВНОЙ КОНТЕНТ (ДВЕ КОЛОНКИ) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ КОЛОНКА: Должники + Популярное оборудование -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">

                    <!-- Список должников -->
                    <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Должники" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Debtors.Count, StringFormat=' ({0})'}" 
                                           FontSize="14" Foreground="#EF5350" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Debtors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DebtorCardStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DebtAmount, StringFormat='{}{0:N0} ₽'}" 
                                                               FontWeight="Bold" Foreground="#EF5350"/>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding DaysOverdue, StringFormat='Просрочка: {0} дн.'}" 
                                                               FontSize="12" Foreground="#EF5350"/>
                                                    <TextBlock Text=" | " Foreground="#D1D5DB"/>
                                                    <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#6B7280"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Grid.Row="2" Content="Все должники →" 
                                    Command="{Binding ShowAllDebtorsCommand}"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                    Margin="0,15,0,0" Height="35"/>
                        </Grid>
                    </Border>

                    <!-- Популярное оборудование -->
                    <Border Background="White" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Популярное оборудование" 
                                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding PopularEquipment}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DebtorCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding TypeDisplay}" FontSize="12" Foreground="#6B7280"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding RentCount, StringFormat='Аренд: {0}'}" 
                                                               FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} ₽'}" 
                                                               FontWeight="Bold" Foreground="#2E2EFF" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ПРАВАЯ КОЛОНКА: Эффективность менеджеров -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Эффективность менеджеров" 
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Managers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DebtorCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Revenue, StringFormat='{}{0:N0} ₽'}" 
                                                           FontWeight="Bold" Foreground="#2E2EFF"/>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding OrdersCount, StringFormat='Заказов: {0}'}" 
                                                           FontSize="12" Foreground="#6B7280"/>
                                                <TextBlock Text=" | " Foreground="#D1D5DB"/>
                                                <TextBlock Text="{Binding ClientsCount, StringFormat='Клиентов: {0}'}" 
                                                           FontSize="12" Foreground="#6B7280"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ИНДИКАТОР ЗАГРУЗКИ -->
            <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="4" Margin="0,20,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        </Grid>
    </ScrollViewer>
</Page>