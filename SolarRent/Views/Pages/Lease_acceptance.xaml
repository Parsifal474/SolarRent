<Page x:Class="SolarRent.Views.Pages.Lease_acceptance"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:conv="clr-namespace:SolarRent.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="900"
      Title="Приёмка аренды"
      Background="#F5F5F5">

    <Page.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="InfoRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1a1aff"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Приёмка аренды" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Оформление возврата оборудования из аренды" FontSize="13" Foreground="#E0E0FF" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Поиск заказа -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Номер заказа:" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#374151" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Text="{Binding SearchOrderNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180"
                                 Style="{StaticResource SearchTextBoxStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Найти заказ" 
                            Command="{Binding SearchOrderCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="20,0,0,0"
                            Padding="25,12"/>
                </Grid>
            </Border>

            <!-- Статус сообщение -->
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" 
                       FontSize="13" Foreground="{StaticResource WarningOrange}"
                       TextWrapping="Wrap" Margin="0,0,0,15"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Информация о заказе (показывается, когда заказ найден) -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" 
                    Visibility="{Binding HasOrder, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel>
                    <!-- Заголовок -->
                    <TextBlock Text="Информация о заказе" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Данные заказа -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Номер заказа:" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentOrder.Id, StringFormat='#{0}'}" 
                                           FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Клиент:" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentOrder.Client.FullName}" 
                                           FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Телефон:" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentOrder.Client.Phone}" 
                                           FontSize="13"/>
                            </Grid>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="1">
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Период:" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="1" FontSize="13">
                                    <Run Text="{Binding CurrentOrder.StartDate, StringFormat='dd.MM.yyyy'}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding CurrentOrder.EndDate, StringFormat='dd.MM.yyyy'}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Сумма аренды:" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentOrder.RentalPrice, StringFormat='₽ {0:N0}'}" 
                                           FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" FontSize="13"/>
                            </Grid>
                            <Grid Style="{StaticResource InfoRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Залог:" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentOrder.Deposit, StringFormat='₽ {0:N0}'}" 
                                           FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,15,0,15" Background="#E5E7EB"/>

                    <!-- Оборудование для возврата -->
                    <TextBlock Text="Оборудование для возврата" Style="{StaticResource SectionHeaderStyle}"/>

                    <ItemsControl ItemsSource="{Binding EquipmentItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Название оборудования -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                                   Text="{Binding EquipmentName}" 
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>

                                        <!-- Серийный номер -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                            <TextBlock Text="Серийный номер:" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="35" Padding="10,0" FontSize="13"
                                                     BorderThickness="1" BorderBrush="#D1D5DB"
                                                     IsReadOnly="True" Background="#F3F4F6"/>
                                        </StackPanel>

                                        <!-- Состояние при возврате -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                            <TextBlock Text="Состояние при возврате:" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="#374151" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton GroupName="Condition" Content="Отличное" 
                                                             IsChecked="{Binding ConditionAtReturn, Mode=TwoWay, ConverterParameter=Отличное}"
                                                             Margin="0,0,15,0" FontSize="13"/>
                                                <RadioButton GroupName="Condition" Content="Хорошее" 
                                                             IsChecked="{Binding ConditionAtReturn, Mode=TwoWay, ConverterParameter=Хорошее}"
                                                             Margin="0,0,15,0" FontSize="13"/>
                                                <RadioButton GroupName="Condition" Content="Среднее" 
                                                             IsChecked="{Binding ConditionAtReturn, Mode=TwoWay, ConverterParameter=Среднее}"
                                                             Margin="0,0,15,0" FontSize="13"/>
                                                <RadioButton GroupName="Condition" Content="Повреждено" 
                                                             IsChecked="{Binding ConditionAtReturn, Mode=TwoWay, ConverterParameter=Повреждено}"
                                                             FontSize="13"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Повреждения (показываются, если состояние не отличное/хорошее) -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                                    Visibility="{Binding IsDamaged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Описание повреждений:" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource DangerRed}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding DamageDescription}"
                                                     Height="60" Padding="10" FontSize="12"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     BorderThickness="1" BorderBrush="#EF4444"
                                                     Background="#FFF5F5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,15,0,15" Background="#E5E7EB"/>

                    <!-- Пеня за просрочку -->
                    <Grid Margin="0,0,0,15" Visibility="{Binding TotalPenalty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Пеня за просрочку:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerRed}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalPenalty, StringFormat='₽ {0:N0}'}" 
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                    </Grid>

                    <!-- Общие примечания -->
                    <TextBlock Text="Примечания" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Notes}" Height="80" Padding="10" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             BorderThickness="1" BorderBrush="#D1D5DB"/>

                    <!-- Кнопки действий -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center">
                            При повреждении оборудования залог не возвращается
                        </TextBlock>

                        <Button Content="Подтвердить возврат" 
                            Command="{Binding AcceptReturnCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding HasOrder}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Индикатор загрузки -->
            <ProgressBar Grid.RowSpan="4" IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </ScrollViewer>
</Page>