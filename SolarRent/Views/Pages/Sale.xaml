<Page x:Class="SolarRent.Views.Pages.Sale"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SolarRent.Models"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1400"
      Title="Продажа оборудования"
      Background="#F5F5F5">

    <Page.Resources>
        <!-- Цвета -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- Стиль карточки товара -->
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E2EFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1a1aff"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль поля ввода -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Стиль ComboBox -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Height" Value="40"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}" Padding="25,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛒" FontSize="28" Margin="0,0,10,0"/>
                    <TextBlock Text="Продажа оборудования" 
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📄 История продаж" 
                            Background="White" Foreground="#2E2EFF"
                            Padding="15,8" Margin="0,0,10,0"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                            Click="HistoryButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: Каталог товаров -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Поиск и фильтры -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Поиск оборудования" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource InputStyle}" 
                                     Margin="0,0,10,0"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <ComboBox Grid.Column="1" Width="170" Margin="0,0,10,0"
                                      Style="{StaticResource ComboBoxStyle}"
                                      SelectedValue="{Binding SelectedType}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Все типы" Tag="{x:Null}"/>
                                <ComboBoxItem Content="🔆 Панели" Tag="Panel"/>
                                <ComboBoxItem Content="⚡ Инверторы" Tag="Inverter"/>
                                <ComboBoxItem Content="🔋 Аккумуляторы" Tag="Battery"/>
                                <ComboBoxItem Content="🔧 Комплектующие" Tag="Accessory"/>
                            </ComboBox>

                            <Button Grid.Column="2" Content="🔍 Найти" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Background="#E5E7EB" Foreground="#374151"
                                    Command="{Binding SearchCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Индикатор загрузки -->
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="0,0,0,10">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <!-- Сетка товаров -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding EquipmentList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <StackPanel>
                                            <Border Background="#F0FDF4" CornerRadius="6" Height="100" Margin="-15,-15,-15,10">
                                                <TextBlock Text="{Binding TypeDisplay}" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TypeDisplay}" FontSize="12" Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding PowerDisplay}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding Price, StringFormat='💰 {0:N0} ₽'}" FontSize="18" FontWeight="Bold" Foreground="#2E2EFF" Margin="0,0,0,10"/>
                                            <Button Content="➕ В корзину" 
                                                    Background="#10B981" Foreground="White"
                                                    Padding="10,6" BorderThickness="0" Cursor="Hand" FontWeight="Medium"
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Пагинация -->
                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding PageInfo}" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="←" Width="35" Height="35" Margin="0,0,5,0"
                                    Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}"
                                    Background="#E5E7EB" BorderThickness="0" Cursor="Hand"/>
                            <TextBlock Text="{Binding CurrentPage}" Width="35" Height="35" 
                                       Background="#2E2EFF" Foreground="White" 
                                       TextAlignment="Center" VerticalAlignment="Center" 
                                       FontWeight="Bold" Margin="0,0,5,0"/>
                            <Button Content="→" Width="35" Height="35"
                                    Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                                    Background="#E5E7EB" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Правая часть: Корзина -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок корзины -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="🛒 Корзина" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Cart.Count, StringFormat='{}{0} товаров'}" FontSize="13" Foreground="#6B7280"/>
                    </StackPanel>

                    <!-- Список товаров в корзине -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock FontSize="12" Foreground="#6B7280">
                                                    <Run Text="{Binding Price, StringFormat={}{0:N0}}"/>
                                                    <Run Text=" ₽ × "/>
                                                    <Run Text="{Binding Quantity}"/>
                                                    <Run Text=" шт"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} ₽'}" 
                                                           FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat='×{0} шт'}" 
                                                           FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                                                <Button Content="🗑" Foreground="#EF4444" Background="Transparent" 
                                                        BorderThickness="0" Cursor="Hand" FontSize="12" 
                                                        HorizontalAlignment="Right" Margin="0,2,0,0"
                                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Итого -->
                    <Border Grid.Row="2" Background="#F0F0FF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Итого:" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding CartTotal, StringFormat='{}{0:N0} ₽'}" 
                                       FontSize="20" FontWeight="Bold" Foreground="#2E2EFF"/>
                        </Grid>
                    </Border>

                    <!-- Кнопки действий -->
                    <StackPanel Grid.Row="3">
                        <Button Content="✅ Оформить продажу" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="50" Margin="0,0,0,10" FontSize="16"
                                Command="{Binding CheckoutCommand}"/>

                        <Button Content="🧹 Очистить корзину" 
                                Background="#E5E7EB" Foreground="#374151"
                                Height="40" BorderThickness="0" Cursor="Hand" FontWeight="Medium"
                                Command="{Binding ClearCartCommand}"/>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>