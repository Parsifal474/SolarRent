<Page x:Class="SolarRent.Views.Pages.Clients"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:SolarRent.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Клиенты"
      Background="#F5F5F5">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <vm:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <vm:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <vm:BlacklistButtonConverter x:Key="BlacklistButtonConverter"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="StatTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список клиентов -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="База клиентов" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <!-- Поиск -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Padding="10,0" FontSize="14"/>
                    <Button Grid.Column="1" Content="🔍" Width="40" Height="35" Margin="5,0,0,0"
                            Command="{Binding SearchCommand}"
                            Background="#E5E7EB" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Список клиентов -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Clients}" 
                         SelectedItem="{Binding SelectedClient}"
                         DisplayMemberPath="FullName"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Phone}" FontSize="12" Foreground="#666"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E0E0FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Правая панель: детали клиента и статистика -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Статистика -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Всего заказов" Style="{StaticResource StatTitleStyle}"/>
                            <TextBlock Text="{Binding TotalOrders}" Style="{StaticResource StatValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Общая сумма" Style="{StaticResource StatTitleStyle}"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:N0} ₽'}" Style="{StaticResource StatValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Просрочки" Style="{StaticResource StatTitleStyle}"/>
                            <TextBlock Text="{Binding OverdueCount}" Style="{StaticResource StatValueStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Карточка выбранного клиента -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20">
                <Grid>
                    <!-- Содержимое при выбранном клиенте -->
                    <Grid Visibility="{Binding SelectedClient, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Имя и ID -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="{Binding SelectedClient.FullName}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedClient.Id, StringFormat=' (ID: {0})'}" FontSize="16" 
                                       Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Контакты -->
                        <TextBlock Grid.Row="1" Text="Контактная информация" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Grid.Row="2" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Телефон:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                <TextBlock Text="Email:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                <TextBlock Text="Адрес:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedClient.Phone}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedClient.Email}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedClient.Address}" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Grid>

                        <!-- Предупреждение о чёрном списке -->
                        <Border Grid.Row="3" Background="#FFEBEE" CornerRadius="6" Padding="10" Margin="0,0,0,15"
                                Visibility="{Binding SelectedClient.IsBlacklisted, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Клиент находится в чёрном списке" FontWeight="SemiBold" Foreground="#C62828"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Юр. информация -->
                        <StackPanel Grid.Row="4" Visibility="{Binding SelectedClient.Type, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Company'}">
                            <TextBlock Text="Юридическая информация" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ИНН:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Text="Название:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SelectedClient.TaxId}" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding SelectedClient.CompanyName}" Margin="0,0,0,5"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Кнопки действий -->
                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="История заказов" Width="140" Height="35" Margin="0,0,10,0"
                                    Command="{Binding ShowOrderHistoryCommand}"
                                    CommandParameter="{Binding SelectedClient}"
                                    Background="#E5E7EB" Foreground="#374151" FontSize="14"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Редактировать" Width="120" Height="35" Margin="0,0,10,0"
                                    Command="{Binding EditClientCommand}"
                                    CommandParameter="{Binding SelectedClient}"
                                    Background="#E5E7EB" Foreground="#374151" FontSize="14"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Удалить" Width="100" Height="35" Margin="0,0,10,0"
                                    Command="{Binding DeleteClientCommand}"
                                    CommandParameter="{Binding SelectedClient}"
                                    Background="#EF5350" Foreground="White" FontSize="14"
                                    BorderThickness="0" Cursor="Hand"/>
                            <Button Content="{Binding SelectedClient.IsBlacklisted, Converter={StaticResource BlacklistButtonConverter}}" 
                                    Width="140" Height="35"
                                    Command="{Binding ToggleBlacklistCommand}"
                                    CommandParameter="{Binding SelectedClient}"
                                    Background="#EF5350" Foreground="White" FontSize="14"
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Placeholder, если клиент не выбран -->
                    <TextBlock Text="Выберите клиента из списка" FontSize="16" Foreground="#999"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedClient, Converter={StaticResource NullToCollapsedConverter}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Индикатор загрузки -->
        <ProgressBar Grid.ColumnSpan="2" IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</Page>