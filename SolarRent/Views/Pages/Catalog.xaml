<Page x:Class="SolarRent.Views.Pages.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SolarRent.ViewModels"
      xmlns:conv="clr-namespace:SolarRent.Converters"
      Title="Каталог оборудования"
      Background="#F5F5F5">

    <Page.Resources>
        <!-- Конвертеры -->
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Цвета -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#86EFAC"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningYellow" Color="#F59E0B"/>
        <SolidColorBrush x:Key="GrayBackground" Color="#F3F4F6"/>

        <!-- Стиль для карточки оборудования -->
        <Style x:Key="EquipmentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий в карточке -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль для пагинации -->
        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль для поля поиска -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для панели фильтров -->
        <Style x:Key="FilterPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для заголовков фильтров -->
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для ComboBox фильтров -->
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>

        <!-- Стиль для TextBox фильтров -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>

        <!-- Стиль для кнопок фильтров -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <Grid Grid.Row="0" Margin="20,15,20,10">
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource SearchTextBoxStyle}"
                     Tag="Поиск по названию...">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </Grid>

        <!-- 🔥 Панель фильтров (появляется при нажатии кнопки "Фильтры" в шапке) -->
        <Border Grid.Row="1" 
                Style="{StaticResource FilterPanelStyle}" 
                Margin="20,0,20,10"
                Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Тип оборудования -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Тип оборудования" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Types}" 
                              SelectedValue="{Binding SelectedType}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              Style="{StaticResource FilterComboBoxStyle}"/>
                </StackPanel>

                <!-- Статус -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Статус" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Statuses}" 
                              SelectedItem="{Binding SelectedStatus}"
                              Style="{StaticResource FilterComboBoxStyle}"/>
                </StackPanel>

                <!-- Макс. мощность -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,15,0">
                    <TextBlock Text="Макс. мощность (кВт)" Style="{StaticResource FilterLabelStyle}"/>
                    <TextBox Text="{Binding MaxPower, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource FilterTextBoxStyle}"
                             InputScope="Number"/>
                </StackPanel>

                <!-- Макс. цена -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,15,0">
                    <TextBlock Text="Макс. цена (₽)" Style="{StaticResource FilterLabelStyle}"/>
                    <TextBox Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource FilterTextBoxStyle}"
                             InputScope="Number"/>
                </StackPanel>

                <!-- Кнопки действий -->
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Применить" 
                            Style="{StaticResource FilterButtonStyle}"
                            Background="{StaticResource PrimaryBlue}"
                            Foreground="White"
                            Command="{Binding ApplyFiltersCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Сбросить" 
                            Style="{StaticResource FilterButtonStyle}"
                            Background="#E5E7EB"
                            Foreground="#374151"
                            Command="{Binding ResetFiltersCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Индикатор загрузки -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="4" VerticalAlignment="Top">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Список оборудования -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding EquipmentList}" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource EquipmentCardStyle}" Width="300">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Иконка по типу -->
                            <Border Grid.Row="0" Background="#F0FDF4" CornerRadius="8" Height="120" Margin="-15,-15,-15,15">
                                <Viewbox Width="60" Height="60">
                                    <TextBlock Text="{Binding TypeDisplay}" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Viewbox>
                            </Border>

                            <!-- Название -->
                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,10"/>

                            <!-- Характеристики -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Тип:" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeDisplay}" FontSize="12" Foreground="#374151" FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Мощность:" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PowerDisplay}" FontSize="12" Foreground="#374151" FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Цена/день:" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PricePerDay, StringFormat='{}{0:N0} ₽'}" FontSize="12" Foreground="#374151" FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>

                            <!-- Статус -->
                            <Border Grid.Row="3" Background="{StaticResource SuccessGreen}" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                                <TextBlock Text="{Binding StatusDisplay}" Foreground="#166534" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Кнопки -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                        Content="✎ Изменить" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        HorizontalAlignment="Left"/>

                                <Button Grid.Column="1" 
                                        Content="🗑 Удалить" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        HorizontalAlignment="Right" 
                                        Foreground="{StaticResource DangerRed}"
                                        Command="{Binding DeleteCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Пагинация -->
        <Grid Grid.Row="4" Margin="20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Информация о странице -->
            <TextBlock Grid.Column="0" 
                       Text="{Binding PageInfo}" 
                       FontSize="14" 
                       VerticalAlignment="Center"/>

            <!-- Кнопки навигации -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="← Назад" 
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="White"
                        Foreground="#374151"
                        FontSize="14"
                        BorderThickness="1"
                        BorderBrush="#D1D5DB"
                        Cursor="Hand"
                        Command="{Binding PrevPageCommand}"
                        IsEnabled="{Binding CanGoPrev}"/>

                <Border Background="{StaticResource PrimaryBlue}" 
                        CornerRadius="6" 
                        Padding="15,5"
                        Margin="0,0,10,0">
                    <TextBlock Text="{Binding CurrentPage}" 
                               Foreground="White" 
                               FontWeight="Bold"
                               FontSize="14"/>
                </Border>

                <TextBlock Text="{Binding TotalPages, StringFormat='из {0}'}" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <Button Content="Далее →" 
                        Width="100"
                        Height="40"
                        Background="White"
                        Foreground="#374151"
                        FontSize="14"
                        BorderThickness="1"
                        BorderBrush="#D1D5DB"
                        Cursor="Hand"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>