<Window x:Class="SolarRent.Views.SalesHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История продаж" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📊 История продаж" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Просмотр и управление продажами оборудования" FontSize="13" Foreground="#E0E0FF" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="📄 Экспорт в CSV" 
                        Command="{Binding ExportToCsvCommand}"
                        Background="White" Foreground="{StaticResource PrimaryBlue}"
                        Padding="20,12" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="С:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" Height="35" Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" Text="По:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" Height="35" Margin="0,0,20,0"/>

                <Button Grid.Column="5" Content="Применить" 
                        Command="{Binding ApplyDateFilterCommand}"
                        Width="120" Height="35"
                        Background="{StaticResource PrimaryBlue}" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Статистика -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Всего продаж" FontSize="14" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="Bold" Foreground="#1F2937"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Общая сумма" FontSize="14" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding TotalSales, StringFormat='{}{0:N0} ₽'}" 
                               FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Средний чек" FontSize="14" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding AverageCheck, StringFormat='{}{0:N0} ₽'}" 
                               FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Список продаж -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" Padding="15,0" FontSize="14"
                             BorderBrush="#D1D5DB" BorderThickness="1">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="🔍 Найти" Width="100" Height="40" Margin="10,0"
                            Command="{Binding SearchCommand}"
                            Background="{StaticResource PrimaryBlue}" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>

                    <Button Grid.Column="2" Content="Очистить" Width="100" Height="40"
                            Command="{Binding ClearSearchCommand}"
                            Background="#E5E7EB" Foreground="#374151"
                            FontWeight="Medium" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Таблица -->
                <ListView Grid.Row="1" ItemsSource="{Binding Sales}" 
                          SelectedItem="{Binding SelectedSale}"
                          MouseDoubleClick="ListView_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="Дата" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SaleDate, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Клиент" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Client.FullName}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Телефон" Width="130" DisplayMemberBinding="{Binding Client.Phone}"/>
                            <GridViewColumn Header="Товаров" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Items.Count}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Сумма" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} ₽'}" 
                                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Оплата" Width="100" DisplayMemberBinding="{Binding PaymentMethod}"/>
                            <GridViewColumn Header="Менеджер" Width="150" DisplayMemberBinding="{Binding ManagedBy.FullName}"/>
                            <GridViewColumn Header="" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" 
                                                Command="{Binding DataContext.DeleteSaleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="#EF4444"
                                                BorderThickness="0" Cursor="Hand"
                                                FontSize="16"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Индикатор загрузки -->
        <ProgressBar Grid.RowSpan="4" IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Window>