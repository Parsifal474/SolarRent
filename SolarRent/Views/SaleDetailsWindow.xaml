<!-- Views/SaleDetailsWindow.xaml -->
<Window x:Class="SolarRent.Views.SaleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали продажи" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Детали продажи" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Информация о продаже -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Клиент:" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Client.FullName}" Margin="0,5,0,10"/>
                    <TextBlock Text="Телефон:" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Client.Phone}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Дата:" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SaleDate, StringFormat='dd.MM.yyyy HH:mm'}" Margin="0,5,0,10"/>
                    <TextBlock Text="Способ оплаты:" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PaymentMethod}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Список товаров -->
        <ListView Grid.Row="2" ItemsSource="{Binding Items}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Equipment.Name}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Цена" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N0} ₽'}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Кол-во" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Сумма" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N0} ₽'}" 
                                           FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Итого -->
        <Border Grid.Row="3" Background="{StaticResource PrimaryBlue}" CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ИТОГО:" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:N0} ₽'}" 
                           FontSize="20" FontWeight="Bold" Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</Window>