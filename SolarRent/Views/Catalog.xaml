<Window x:Class="SolarRent.Catalog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SolarRent.ViewModels"
        Title="SolarRent - Каталог оборудования" 
        Height="800" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <!-- 🔥 ДОБАВЬ ЭТОТ БЛОК -->
    <Window.Resources>
        <!-- Цвета -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2E2EFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#86EFAC"/>

        <!-- Стили -->
        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2E2EFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EquipmentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PaginationActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource PaginationButtonStyle}">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7C3AED"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBlue}" Padding="25,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Каталог оборудования" Style="{StaticResource HeaderTitleStyle}"/>
                <Button Grid.Column="1" Content="+ Добавить оборудование" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <!-- Поиск -->
        <Grid Grid.Row="1" Margin="20,15,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBoxStyle}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Найти" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SearchCommand}" Margin="10,0,0,0"/>
        </Grid>

        <!-- Индикатор загрузки -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="4" VerticalAlignment="Top">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- 🔥 ДИНАМИЧЕСКИЙ СПИСОК (вместо хардкода карточек) -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding EquipmentList}" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource EquipmentCardStyle}" Width="300">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Иконка по типу -->
                            <Border Grid.Row="0" Background="#F0FDF4" CornerRadius="8" Height="120" Margin="-15,-15,-15,15">
                                <Viewbox Width="60" Height="60">
                                    <TextBlock Text="{Binding TypeDisplay}" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Viewbox>
                            </Border>

                            <!-- Название -->
                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,10"/>

                            <!-- Характеристики -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Тип:" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeDisplay}" FontSize="12" Foreground="#374151" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Мощность:" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PowerDisplay}" FontSize="12" Foreground="#374151" FontWeight="Medium"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Цена/день:" FontSize="12" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PricePerDay, StringFormat='{}{0:N0} ₽'}" FontSize="12" Foreground="#374151" FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>

                            <!-- Статус -->
                            <Border Grid.Row="3" Background="{StaticResource SuccessGreen}" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                                <TextBlock Text="{Binding StatusDisplay}" Foreground="#166534" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Кнопки в карточке -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
            Content="✎ Изменить" 
            Style="{StaticResource ActionButtonStyle}" 
            HorizontalAlignment="Left"/>

                                <!-- 🔥 Кнопка Удалить с привязкой к команде карточки -->
                                <Button Grid.Column="1" 
            Content="🗑 Удалить" 
            Style="{StaticResource ActionButtonStyle}" 
            HorizontalAlignment="Right" 
            Foreground="#EF4444"
            Command="{Binding DeleteCommand}"/>
                                <!-- 🔥 Важно: команда из EquipmentItem -->
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Пагинация -->
        <Grid Grid.Row="3" Margin="20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Информация о странице -->
            <TextBlock Grid.Column="0" 
               Text="{Binding PageInfo}" 
               FontSize="14" 
               VerticalAlignment="Center"/>

            <!-- Кнопки навигации -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Назад -->
                <Button Content="← Назад" 
                Style="{StaticResource PaginationButtonStyle}" 
                Width="100"
                Margin="0,0,10,0"
                Command="{Binding PrevPageCommand}"
                IsEnabled="{Binding CanGoPrev}"/>

                <!-- Номер страницы -->
                <Border Background="{StaticResource PrimaryBlue}" 
                CornerRadius="6" 
                Padding="15,5"
                Margin="0,0,10,0">
                    <TextBlock Text="{Binding CurrentPage}" 
                       Foreground="White" 
                       FontWeight="Bold"
                       FontSize="14"/>
                </Border>

                <!-- Из всего -->
                <TextBlock Text="{Binding TotalPages, StringFormat='из {0}'}" 
                   FontSize="14" 
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>

                <!-- Далее -->
                <Button Content="Далее →" 
                Style="{StaticResource PaginationButtonStyle}" 
                Width="100"
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoNext}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window> 