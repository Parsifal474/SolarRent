<Window x:Class="SolarRent.EditEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolarRent - Редактирование оборудования" 
        Height="700" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#7C3AED" Padding="0,15">
            <TextBlock Text="Редактировать оборудование" 
                       FontSize="24" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <Border Grid.Row="1" Background="White" Padding="30">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Название -->
                    <TextBlock Text="Название *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtName" Height="40" Margin="0,0,0,15" Padding="10,0" FontSize="14"/>

                    <!-- Тип (только просмотр) -->
                    <TextBlock Text="Тип" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTypeDisplay" Height="40" Margin="0,0,0,15" Padding="10,0" 
                             FontSize="14" Background="#F9FAFB" IsReadOnly="True" Foreground="#6B7280"/>

                    <!-- Мощность -->
                    <TextBlock Text="Мощность *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPower" Height="40" Margin="0,0,0,15" Padding="10,0" FontSize="14"/>
                    <TextBlock Text="Пример: 300 или 5.5 (без единиц измерения)" FontSize="11" Foreground="#999" Margin="0,-10,0,15"/>

                    <!-- Базовая цена -->
                    <TextBlock Text="Базовая цена (₽) *" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPrice" Height="40" Margin="0,0,0,15" Padding="10,0" FontSize="14"/>
                    <TextBlock Text="От этой суммы считается: аренда 1%/день, залог 50%" FontSize="11" Foreground="#999" Margin="0,-10,0,15"/>

                    <!-- Расчётные значения -->
                    <Border Background="#F0F0FF" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="📊 Расчётные значения:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Аренда/день:" FontSize="12"/>
                                <TextBlock x:Name="lblRentalPricePerDay" Grid.Column="1" Text="₽ 0/день" FontSize="12" FontWeight="Bold" Foreground="#2E2EFF"/>
                            </Grid>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Залог:" FontSize="12"/>
                                <TextBlock x:Name="lblDepositAmount" Grid.Column="1" Text="₽ 0" FontSize="12" FontWeight="Bold" Foreground="#2E2EFF"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Описание -->
                    <TextBlock Text="Описание" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtDescription" Height="80" Margin="0,0,0,15" Padding="10" FontSize="14" 
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                    <!-- Скрытый ID -->
                    <TextBlock x:Name="txtId" Visibility="Collapsed"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <Border Padding="30,20" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Отмена" Width="120" Height="40" Margin="0,0,10,0"
                        Background="#E5E7EB" Foreground="#374151" FontSize="14" FontWeight="Medium"
                        BorderThickness="0" Cursor="Hand" Click="CancelButton_Click"/>

                <Button Grid.Column="2" Content="Сохранить изменения" Width="180" Height="40"
                        Background="#7C3AED" Foreground="White" FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Click="SaveButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>